    "kn": [
      "ನ ತಥೇಚ್ಛನ್ತಿ ಕಲ್ಯಾಣಾನ್ ಪರೇಷಾಂ ವೇದಿತುಂ ಗುಣಾನ್ ೤",
      "ಯಥೈಷಾಂ ಜ್ಞಾತುಮಿಚ್ಛನ್ತಿ ನೈರ್ಗುಣ್ಯಂ ಪಾಪಚೇತಸಃ ೥ ೧೧ ೥"
    ]
