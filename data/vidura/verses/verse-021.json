  "theme": "How virtues are preserved",
  "reading": {
    "dev": [
      "सत्येन रक्ष्यते धर्मो विद्या योगेन रक्ष्यते ।",
      "मृजया रक्ष्यते रूपं कुलं वृत्तेन रक्ष्यते ॥ २१ ॥"
    ],
    "iast": [
      "satyena rakṣyate dharmo vidyā yogena rakṣyate |",
      "mṛjayā rakṣyate rūpaṃ kulaṃ vṛttena rakṣyate || 21 ||"
    ],
    "kn": [
      "ಸತ್ಯೇನ ರಕ್ಷ್ಯತೇ ಧರ್ಮೋ ವಿದ್ಯಾ ಯೋಗೇನ ರಕ್ಷ್ಯತೇ ೤",
      "ಮೃಜಯಾ ರಕ್ಷ್ಯತೇ ರೂಪಂ ಕುಲಂ ವೃತ್ತೇನ ರಕ್ಷ್ಯತೇ ೥ ೨೧ ೥"
    ]
  },
  "meaning": {
    "en": "Dharma is protected by truth, knowledge is protected by practice, beauty is protected by cleanliness and a dynasty is protected by good character.",
    "kn": "ಸತ್ಯದಿಂದ ಧರ್ಮ ರಕ್ಷಿತವಾಗುತ್ತದೆ; ಅಭ್ಯಾಸದಿಂದ ವಿದ್ಯೆ ಉಳಿಯುತ್ತದೆ; ಶುಚಿತ್ವದಿಂದ ರೂಪ ಸಂರಕ್ಷಿತವಾಗುತ್ತದೆ; ಉತ್ತಮ ನಡತೆಯಿಂದ ಕುಲದ ಗೌರವ ಉಳಿಯುತ್ತದೆ."
  },
  "deeper_meaning": {
    "en": "Good qualities need sustaining practices. Truth supports dharma, learning requires use, cleanliness maintains appearance, and conduct—not birth alone—protects a family's standing.",
    "kn": "ಗುಣಗಳು ತಾನಾಗಿಯೇ ಉಳಿಯುವುದಿಲ್ಲ. ಸತ್ಯ, ಅಭ್ಯಾಸ, ಶುಚಿತ್ವ ಮತ್ತು ಸದಾಚಾರ ಅವುಗಳನ್ನು ಕಾಪಾಡುತ್ತವೆ."
  },
