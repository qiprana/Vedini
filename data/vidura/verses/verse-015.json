    "dev": [
      "द्वे कर्मणी नरः कुर्वन्नस्मिंल्लोके विरोचते ।",
      "अब्रुवन् परुषं किञ्चिदसतोऽनर्चयं स्तथा ॥ १५ ॥"
    ],
    "iast": [
      "dve karmaṇī naraḥ kurvannasmiṃlloke virocate |",
      "abruvan paruṣaṃ kiñcidasato'narcayaṃstathā || 15 ||"
    ],
    "kn": [
      "ದ್ವೇ ಕರ್ಮಣೀ ನರಃ ಕುರ್ವನ್ನಸ್ಮಿಂಲ್ಲೋಕೇ ವಿರೋಚತೇ ೤",
      "ಅಬ್ರುವನ್ ಪರುಷಂ ಕಿಞ್ಚಿದಸತೋಽನರ್ಚಯಂ ಸ್ತಥಾ ೥ ೧೫ ೥"
    ]
  },
  "meaning": {
    "en": "A man earns fame by doing these two things; firstly by not speaking harsh words and secondly by not worshipping the wicked.",
    "kn": "ಕಠೋರ ಮಾತುಗಳನ್ನು ಆಡದಿರುವುದು ಮತ್ತು ದುರ್ಜನರನ್ನು ಗೌರವದಿಂದ ಪೂಜಿಸದಿರುವುದು — ಈ ಎರಡು ನಡೆಗಳಿಂದ ವ್ಯಕ್ತಿ ಸಮಾಜದಲ್ಲಿ ಗೌರವ ಪಡೆಯುತ್ತಾನೆ."
  },
  "deeper_meaning": {
    "en": "Respect is earned through restraint in speech and discernment in whom we honor. Refusing to speak harshly need not mean approving harmful conduct.",
    "kn": "ಮಾತಿನಲ್ಲಿ ಸಂಯಮ ಮತ್ತು ಯಾರನ್ನು ಗೌರವಿಸಬೇಕು ಎಂಬ ವಿವೇಕದಿಂದ ನಿಜವಾದ ಗೌರವ ದೊರೆಯುತ್ತದೆ."
  },
