  "theme": "Mistaking friends for enemies",
  "reading": {
    "dev": [
      "अमित्रं कुरुते मित्रं मित्रं द्वेष्टि हिनस्ति च ।",
      "कर्म चारभते दुष्टं तमाहुर्मूढचेतसम् ॥ १० ॥"
    ],
    "iast": [
      "amitraṃ kurute mitraṃ mitraṃ dveṣṭi hinasti ca |",
      "karma cārabhate duṣṭaṃ tamāhurmūḍhacetasam || 10 ||"
    ],
    "kn": [
      "ಅಮಿತ್ರಂ ಕುರುತೇ ಮಿತ್ರಂ ಮಿತ್ರಂ ದ್ವೇಷ್ಟಿ ಹಿನಸ್ತಿ ಚ ೤",
      "ಕರ್ಮ ಚಾರಭತೇ ದುಷ್ಟಂ ತಮಾಹುರ್ಮೂಢಚೇತಸಮ್ ೥ ೧೦ ೥"
    ]
  },
  "meaning": {
    "en": "A foolish person is one who considers his enemy as friend, behaves like an enemy towards his friend, wishes to destroy him and indulges in wicked deeds.",
    "kn": "ಶತ್ರುವನ್ನು ಮಿತ್ರನೆಂದು ಭಾವಿಸಿ, ಮಿತ್ರನನ್ನು ದ್ವೇಷಿಸಿ ಹಾನಿ ಮಾಡುವವನು ಹಾಗೂ ಕೆಟ್ಟ ಕೆಲಸಗಳಲ್ಲಿ ತೊಡಗುವವನು ಮೂಢಬುದ್ಧಿಯವನು."
  },
  "deeper_meaning": {
    "en": "Lack of discernment can reverse loyalty: a harmful influence is trusted and a true friend is treated as a threat. Vidura links these errors of judgment with destructive action. Wisdom demands recognizing character before choosing alliances or acting in anger.",
    "kn": "ಯಾರು ನಿಜವಾದ ಹಿತೈಷಿ ಮತ್ತು ಯಾರು ಹಾನಿಕರರು ಎಂಬುದನ್ನು ಗುರುತಿಸದಿದ್ದರೆ ತಪ್ಪಾದ ಸಂಬಂಧಗಳು ಮತ್ತು ಕೆಟ್ಟ ಕಾರ್ಯಗಳು ಉಂಟಾಗುತ್ತವೆ. ವಿವೇಕ ಅಗತ್ಯ."
  },
