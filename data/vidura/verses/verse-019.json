  "collection": "vidura-niti",
  "verse_number": 19,
  "theme": "The nature of a noble person",
  "reading": {
    "dev": [
      "न स्वे सुखे वै कुरुते प्रहर्षं नान्यस्य दुःखे भवति प्रहृष्टः ।",
      "दत्त्वा न पश्चात् कुरुतेऽनुतापं स कथ्यते सत्पुरुषार्थशीलः ॥ १९ ॥"
    ],
    "iast": [
      "na sve sukhe vai kurute praharṣaṃ nānyasya duḥkhe bhavati prahṛṣṭaḥ |",
      "dattvā na paścāt kurute'nutāpaṃ sa kathyate satpuruṣārthaśīlaḥ || 19 ||"
    ],
    "kn": [
      "ನ ಸ್ವೇ ಸುಖೇ ವೈ ಕುರುತೇ ಪ್ರಹರ್ಷಂ ನಾನ್ಯಸ್ಯ ದುಃಖೇ ಭವತಿ ಪ್ರಹೃಷ್ಟಃ ೤",
      "ದತ್ತ್ವಾ ನ ಪಶ್ಚಾತ್ ಕುರುತೇಽನುತಾಪಂ ಸ ಕಥ್ಯತೇ ಸತ್ಪುರುಷಾರ್ಥಶೀಲಃ ೥ ೧೯ ೥"
    ]
  },
  "meaning": {
    "en": "He alone is called a noble person with an excellent conduct who does not over-rejoice at his own fortunes, does not feel happy when others are in distress and does not repent after having given something in charity.",
    "kn": "ತನ್ನ ಸುಖಕ್ಕೆ ಅತಿಯಾಗಿ ಹರ್ಷಿಸದೆ, ಇತರರ ದುಃಖದಲ್ಲಿ ಸಂತೋಷಪಡದೆ, ದಾನ ಮಾಡಿದ ಮೇಲೆ ಪಶ್ಚಾತ್ತಾಪಪಡದವನೇ ಸದಾಚಾರದ ಸಜ್ಜನನು."
  },
  "deeper_meaning": {
    "en": "A noble life combines composure in personal happiness, empathy for others' pain and generosity without regret. Vidura calls attention to the inward intention behind outward virtue.",
    "kn": "ತನ್ನ ಸುಖದಲ್ಲಿ ಮಿತಭಾವ, ಇತರರ ನೋವಿಗೆ ಸಹಾನುಭೂತಿ ಮತ್ತು ಪಶ್ಚಾತ್ತಾಪವಿಲ್ಲದ ದಾನ ಸಜ್ಜನಿಕೆಯ ಲಕ್ಷಣಗಳು."
  },
