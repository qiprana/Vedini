  "reading": {
    "dev": [
      "परिच्छदेन क्षेत्रेण वेश्मना परिचर्यया ।",
      "परीक्षेत कुलं राजन् भोजनाच्छादनेन च ॥ २२ ॥"
    ],
    "iast": [
      "paricchadena kṣetreṇa veśmanā paricaryayā |",
      "parīkṣeta kulaṃ rājan bhojanācchādanena ca || 22 ||"
    ],
    "kn": [
      "ಪರಿಚ್ಛದೇನ ಕ್ಷೇತ್ರೇಣ ವೇಶ್ಮನಾ ಪರಿಚರ್ಯಯಾ ೤",
      "ಪರೀಕ್ಷೇತ ಕುಲಂ ರಾಜನ್ ಭೋಜನಾಚ್ಛಾದನೇನ ಚ ೥ ೨೨ ೥"
    ]
  },
  "meaning": {
    "en": "O king ! a dynasty is tested by its external appendages, attendants, birth-places, habitations, services, food habits and clothing.",
    "kn": "ರಾಜನೇ, ಕುಟುಂಬದ ಸ್ಥಿತಿಯನ್ನು ಅದರ ಸುತ್ತಮುತ್ತಲಿನ ವ್ಯವಸ್ಥೆ, ನೆಲ, ಮನೆ, ಸೇವೆ, ಆಹಾರ ಮತ್ತು ಉಡುಪು ಮುಂತಾದ ಜೀವನದ ಅಂಶಗಳಿಂದ ಪರಿಶೀಲಿಸಬಹುದು."
  },
  "deeper_meaning": {
    "en": "Vidura points to everyday living conditions and conduct as signs by which a household can be understood. The verse reflects its historical social context and should not be turned into a blanket judgment of anyone's worth.",
    "kn": "ಕುಟುಂಬದ ಬದುಕನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಅದರ ದೈನಂದಿನ ಪರಿಸ್ಥಿತಿ ಮತ್ತು ನಡವಳಿಕೆಯನ್ನು ಗಮನಿಸಬೇಕು; ಈ ಮಾತು ಅದರ ಕಾಲದ ಸಾಮಾಜಿಕ ಹಿನ್ನೆಲೆಯಲ್ಲಿದೆ."
  },
