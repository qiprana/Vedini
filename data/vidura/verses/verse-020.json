  "verse_number": 20,
  "theme": "Harmony among relatives",
  "reading": {
    "dev": [
      "सम्भोजनं संकथनं सम्प्रीतिश्च परस्परम् ।",
      "जातिभिः सह कार्याणि न विरोधः कदाचन ॥ २० ॥"
    ],
    "iast": [
      "sambhojanaṃ saṃkathanaṃ samprītiśca parasparam |",
      "jātibhiḥ saha kāryāṇi na virodhaḥ kadācana || 20 ||"
    ],
    "kn": [
      "ಸಮ್ಭೋಜನಂ ಸಂಕಥನಂ ಸಮ್ಪ್ರೀತಿಶ್ಚ ಪರಸ್ಪರಮ್ ೤",
      "ಜಾತಿಭಿಃ ಸಹ ಕಾರ್ಯಾಣಿ ನ ವಿರೋಧಃ ಕದಾಚನ ೥ ೨೦ ೥"
    ]
  },
  "meaning": {
    "en": "One should eat jointly, talk smoothly and be with affection with the relations. One should never oppose them.",
    "kn": "ಬಂಧುಗಳೊಂದಿಗೆ ಒಟ್ಟಿಗೆ ಊಟ ಮಾಡುವುದು, ಸೌಹಾರ್ದದಿಂದ ಮಾತನಾಡುವುದು ಮತ್ತು ಪರಸ್ಪರ ಪ್ರೀತಿ ಬೆಳೆಸುವುದು ಒಳ್ಳೆಯದು; ಅನವಶ್ಯಕ ವಿರೋಧ ತಪ್ಪಿಸಬೇಕು."
  },
  "deeper_meaning": {
    "en": "Sharing food and conversation can keep relationships alive. The verse advocates goodwill and affection among relatives rather than nursing avoidable conflicts.",
    "kn": "ಒಟ್ಟಿನ ಊಟ, ಮಾತುಕತೆ ಮತ್ತು ಪ್ರೀತಿ ಕುಟುಂಬದ ಬಾಂಧವ್ಯವನ್ನು ಗಟ್ಟಿಗೊಳಿಸುತ್ತವೆ; ಅನವಶ್ಯಕ ಕಲಹ ಸಂಬಂಧವನ್ನು ದುರ್ಬಲಗೊಳಿಸುತ್ತದೆ."
  },
