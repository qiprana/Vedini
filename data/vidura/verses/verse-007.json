  "theme": "Strength of discernment",
  "reading": {
    "dev": [
      "येन त्वेतानि सर्वाणि सङ्गृहीतानि भारत ।",
      "यद् बलानां बलं श्रेष्ठं तत् प्रज्ञाबलमुच्यते ॥ ७ ॥"
    ],
    "iast": [
      "yena tvetāni sarvāṇi saṅgṛhītāni bhārata |",
      "yad balānāṃ balaṃ śreṣṭhaṃ tat prajñābalamucyate || 7 ||"
    ],
    "kn": [
      "ಯೇನ ತ್ವೇತಾನಿ ಸರ್ವಾಣಿ ಸಙ್ಗೃಹೀತಾನಿ ಭಾರತ ೤",
      "ಯದ್ ಬಲಾನಾಂ ಬಲಂ ಶ್ರೇಷ್ಠಂ ತತ್ ಪ್ರಜ್ಞಾಬಲಮುಚ್ಯತೇ ೥ ೭ ೥"
    ]
  },
  "meaning": {
    "en": "O Bhārata ! Intellectual strength is the best kind of strength amongst all kinds of strengths, since it includes all of them in itself.",
    "kn": "ಓ ಭಾರತ! ಎಲ್ಲ ಬಲಗಳಿಗಿಂತ ಪ್ರಜ್ಞೆಯ ಬಲವೇ ಶ್ರೇಷ್ಠ, ಏಕೆಂದರೆ ಉಳಿದ ಬಲಗಳನ್ನು ಅದು ಒಳಗೊಂಡಿರುತ್ತದೆ."
  },
  "deeper_meaning": {
    "en": "Power is not only physical, material or social. Discernment helps one decide when and how to use other strengths. Vidura calls intelligence the highest strength because judgment can guide every other resource toward a worthy end.",
    "kn": "ದೇಹಬಲ ಅಥವಾ ಸಂಪತ್ತಿಗಿಂತ ವಿವೇಕದ ಶಕ್ತಿ ಮುಖ್ಯ. ಇತರ ಬಲಗಳನ್ನು ಹೇಗೆ ಬಳಸಬೇಕು ಎಂಬ ದಿಕ್ಕನ್ನು ಪ್ರಜ್ಞೆ ನೀಡುತ್ತದೆ."
  },
