    "dev": [
      "यस्य कृत्यं न विघ्नन्ति शीतमुष्णं भयं रतिः ।",
      "समृद्धिरसमृद्धिर्वा स वै पण्डित उच्यते ॥ ९ ॥"
    ],
    "iast": [
      "yasya kṛtyaṃ na vighnanti śītamuṣṇaṃ bhayaṃ ratiḥ |",
      "samṛddhirasamṛddhirvā sa vai paṇḍita ucyate || 9 ||"
    ],
    "kn": [
      "ಯಸ್ಯ ಕೃತ್ಯಂ ನ ವಿಘ್ನನ್ತಿ ಶೀತಮುಷ್ಣಂ ಭಯಂ ರತಿಃ ೤",
      "ಸಮೃದ್ಧಿರಸಮೃದ್ಧಿರ್ವಾ ಸ ವೈ ಪಣ್ಡಿತ ಉಚ್ಯತೇ ೥ ೯ ೥"
    ]
  },
  "meaning": {
    "en": "A learned person is indeed one whose actions are not deterred by winter, summer, fear, attachment to objects of senses, prosperity or adversity.",
    "kn": "ಶೀತ, ಉಷ್ಣ, ಭಯ, ಆಸಕ್ತಿ, ಸಮೃದ್ಧಿ ಅಥವಾ ಕಷ್ಟಗಳಿಂದ ಕರ್ತವ್ಯಕ್ಕೆ ಅಡ್ಡಿಯಾಗದವನೇ ನಿಜವಾದ ಪಂಡಿತನು."
  },
  "deeper_meaning": {
    "en": "The wise person does not let outer conditions decide every action. Heat, cold, fear, pleasure and changing fortunes may be real, but they need not govern one's commitment to appropriate work. The verse values steadiness rather than indifference.",
    "kn": "ಸುಖ–ದುಃಖ, ಭಯ–ಆಸಕ್ತಿ ಮತ್ತು ಬಾಹ್ಯ ಪರಿಸ್ಥಿತಿಗಳ ಮಧ್ಯೆಯೂ ಸಮಂಜಸವಾದ ಕಾರ್ಯವನ್ನು ಮುಂದುವರಿಸುವ ಸ್ಥೈರ್ಯವೇ ಪಾಂಡಿತ್ಯದ ಲಕ್ಷಣ."
  },
