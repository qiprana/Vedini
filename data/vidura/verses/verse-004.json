  "theme": "Respect for elders",
  "reading": {
    "dev": [
      "अभिवादनशीलस्य नित्यं वृद्धोपसेविनः ।",
      "चत्वारि सम्प्रवर्धन्ते कीर्तिरायुर्यशो बलम् ॥ ४ ॥"
    ],
    "iast": [
      "abhivādanaśīlasya nityaṃ vṛddhopasevinaḥ |",
      "catvāri sampravardhante kīrtirāyuryaśo balam || 4 ||"
    ],
    "kn": [
      "ಅಭಿವಾದನಶೀಲಸ್ಯ ನಿತ್ಯಂ ವೃದ್ಧೋಪಸೇವಿನಃ ೤",
      "ಚತ್ವಾರಿ ಸಮ್ಪ್ರವರ್ಧನ್ತೇ ಕೀರ್ತಿರಾಯುರ್ಯಶೋ ಬಲಮ್ ೥ ೪ ೥"
    ]
  },
  "meaning": {
    "en": "Fame, age, reputation and strength - these four things keep on increasing for one who bows and serves the elders.",
    "kn": "ಹಿರಿಯರಿಗೆ ಗೌರವದಿಂದ ವಂದಿಸಿ ಸದಾ ಸೇವೆ ಮಾಡುವವನ ಕೀರ್ತಿ, ಆಯುಷ್ಯ, ಯಶಸ್ಸು ಮತ್ತು ಬಲ — ಈ ನಾಲ್ಕೂ ಹೆಚ್ಚುತ್ತವೆ."
  },
  "deeper_meaning": {
    "en": "Honoring the elderly is presented as more than a courtesy. Receiving guidance, recognizing experience, and serving without arrogance can strengthen character and support a long and respected life. The four fruits describe the value of humility practiced consistently.",
    "kn": "ಹಿರಿಯರ ಅನುಭವವನ್ನು ಗೌರವಿಸಿ ಸೇವೆ ಮಾಡುವುದರಿಂದ ವಿನಯ ಮತ್ತು ಉತ್ತಮ ಗುಣಗಳು ಬೆಳೆಯುತ್ತವೆ. ಕೀರ್ತಿ, ಆಯುಷ್ಯ, ಯಶಸ್ಸು ಮತ್ತು ಬಲವನ್ನು ಈ ಶ್ಲೋಕವು ಅದರ ಫಲವಾಗಿ ಹೇಳುತ್ತದೆ."
  },
