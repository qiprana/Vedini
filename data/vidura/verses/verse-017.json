    ],
    "iast": [
      "īrṣyī ghṛṇī na santuṣṭaḥ krodhano nityaśaṅkitaḥ |",
      "parabhāgyopajīvī ca ṣaḍete nityaduḥkhitāḥ || 17 ||"
    ],
    "kn": [
      "ಈರ್ಷ್ಯೀ ಘೃಣೀ ನ ಸನ್ತುಷ್ಟಃ ಕ್ರೋಧನೋ ನಿತ್ಯಶಙ್ಕಿತಃ ೤",
      "ಪರಭಾಗ್ಯೋಪಜೀವೀ ಚ ಷಡೇತೇ ನಿತ್ಯದುಃಖಿತಾಃ ೥ ೧೭ ೥"
    ]
  },
  "meaning": {
    "en": "These six types of people are always unhappy- one who is jealous, one who hates others, one who is never satisfied, one who is short-tempered, one who is always suspicious and one who depends upon other's fortunes.",
    "kn": "ಅಸೂಯೆಪಡುವ, ಇತರರನ್ನು ದ್ವೇಷಿಸುವ, ತೃಪ್ತಿಯಿಲ್ಲದ, ಬೇಗ ಕೋಪಗೊಳ್ಳುವ, ಸದಾ ಅನುಮಾನಿಸುವ ಮತ್ತು ಇತರರ ಭಾಗ್ಯವನ್ನೇ ಅವಲಂಬಿಸುವ ವ್ಯಕ್ತಿಗಳು ನಿರಂತರ ದುಃಖಿತರಾಗಿರುತ್ತಾರೆ."
  },
  "deeper_meaning": {
    "en": "Vidura identifies mental habits that repeatedly create dissatisfaction. Envy, anger and suspicion steal contentment, while dependence on others' fortunes leaves one's peace unstable.",
    "kn": "ಅಸೂಯೆ, ದ್ವೇಷ, ಕೋಪ ಮತ್ತು ಅನುಮಾನ ಮನಶ್ಶಾಂತಿಯನ್ನು ಕಸಿದುಕೊಳ್ಳುತ್ತವೆ. ತೃಪ್ತಿ ಮತ್ತು ಸ್ವಾವಲಂಬನೆ ನೆಮ್ಮದಿಗೆ ನೆರವಾಗುತ್ತವೆ."
  },
