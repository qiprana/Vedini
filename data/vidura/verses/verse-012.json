  "verse_number": 12,
  "theme": "The folly of blaming others",
  "reading": {
    "dev": [
      "परं क्षिपति दोषेण वर्तमानः स्वयं तथा ।",
      "यश्च क्रुध्यत्यनीशानः स च मूढतमो नरः ॥ १२ ॥"
    ],
    "iast": [
      "paraṃ kṣipati doṣeṇa vartamānaḥ svayaṃ tathā |",
      "yaśca krudhyatyanīśānaḥ sa ca mūḍhatamo naraḥ || 12 ||"
    ],
    "kn": [
      "ಪರಂ ಕ್ಷಿಪತಿ ದೋಷೇಣ ವರ್ತಮಾನಃ ಸ್ವಯಂ ತಥಾ ೤",
      "ಯಶ್ಚ ಕ್ರುಧ್ಯತ್ಯನೀಶಾನಃ ಸ ಚ ಮೂಢತಮೋ ನರಃ ೥ ೧೨ ೥"
    ]
  },
  "meaning": {
    "en": "That man is the biggest fool who accuses others with the same blemishes which he has and expresses his anger without having any authority to do the same.",
    "kn": "ತನ್ನಲ್ಲಿಯೂ ಇರುವ ದೋಷವನ್ನೇ ಇತರರಿಗೆ ಆರೋಪಿಸಿ, ಅಧಿಕಾರವಿಲ್ಲದೆ ಕೋಪಗೊಳ್ಳುವ ವ್ಯಕ್ತಿ ಅತ್ಯಂತ ಮೂಢನೆಂದು ಹೇಳಲಾಗಿದೆ."
  },
  "deeper_meaning": {
    "en": "The verse asks us to examine our own conduct before condemning someone else. Anger without self-awareness or responsibility adds folly to hypocrisy.",
    "kn": "ಇತರರನ್ನು ದೂಷಿಸುವ ಮೊದಲು ನಮ್ಮ ನಡವಳಿಕೆಯನ್ನು ಪರಿಶೀಲಿಸಬೇಕು. ಸ್ವದೋಷವನ್ನು ಕಾಣದೆ ಕೋಪಗೊಳ್ಳುವುದು ಅವಿವೇಕ."
  },
