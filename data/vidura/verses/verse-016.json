  "verse_number": 16,
  "theme": "Six virtues to preserve",
  "reading": {
    "dev": [
      "षडेते तु गुणाः पुंसा न हातव्याः कदाचन ।",
      "सत्यं दानमनालस्यमनसूया क्षमा धृतिः ॥ १६ ॥"
    ],
    "iast": [
      "ṣaḍete tu guṇāḥ puṃsā na hātavyāḥ kadācana |",
      "satyaṃ dānamanālasyamanasūyā kṣamā dhṛtiḥ || 16 ||"
    ],
    "kn": [
      "ಷಡೇತೇ ತು ಗುಣಾಃ ಪುಂಸಾ ನ ಹಾತವ್ಯಾಃ ಕದಾಚನ ೤",
      "ಸತ್ಯಂ ದಾನಮನಾಲಸ್ಯಮನಸೂಯಾ ಕ್ಷಮಾ ಧೃತಿಃ ೥ ೧೬ ೥"
    ]
  },
  "meaning": {
    "en": "One should never abandon these six virtues- truth, generosity, hard work, non-jealousy, forgiveness and patience.",
    "kn": "ಸತ್ಯ, ದಾನ, ಸೋಮಾರಿತನವಿಲ್ಲದ ಪರಿಶ್ರಮ, ಅಸೂಯೆ ಇಲ್ಲದ ಮನಸ್ಸು, ಕ್ಷಮೆ ಮತ್ತು ಧೈರ್ಯ — ಈ ಆರು ಗುಣಗಳನ್ನು ಎಂದಿಗೂ ಬಿಡಬಾರದು."
  },
  "deeper_meaning": {
    "en": "These virtues turn ideals into daily habits: honesty, generosity, diligence, freedom from envy, forgiveness and steadiness. Vidura treats character as something to maintain continuously, not display occasionally.",
    "kn": "ಸತ್ಯನಿಷ್ಠೆ, ಔದಾರ್ಯ, ಪರಿಶ್ರಮ, ಅಸೂಯೆ ರಹಿತ ಮನಸ್ಸು, ಕ್ಷಮೆ ಮತ್ತು ಸ್ಥಿರತೆ ದೈನಂದಿನ ಜೀವನದಲ್ಲಿ ಅಭ್ಯಾಸವಾಗಬೇಕಾದ ಗುಣಗಳು."
  },
