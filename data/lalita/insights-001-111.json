      "verse_number": 1,
      "insight": {
        "en": "trust, surrender, and the feeling of being lovingly supported",
        "kn": "ದಿವ್ಯ ತಾಯಿಯ ಮೇಲಿನ ನಂಬಿಕೆ, ಶರಣಾಗತಿ ಮತ್ತು ಪ್ರೀತಿಯ ಆಶ್ರಯದ ಭಾವವನ್ನು ಬೆಳೆಸುತ್ತದೆ."
      }
    },
    {
      "number": 2,
      "verse_number": 1,
      "insight": {
